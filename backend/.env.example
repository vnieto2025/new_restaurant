APP_ENV="development"
DB_USER="postgres"
DB_PASS="your_password_here"
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="restaurant"
# Base que usan las pruebas automáticas (se borra y se recrea en cada corrida)
DB_NAME_TEST="restaurant_test"
MY_SECRET_KEY="your_secret_here"
# Minutos de vida del token de acceso
TOKEN_MINUTES="720"
# Dirección pública de la carta: los QR llevan PUBLIC_URL/q/<token>.
# Para probar con un celular en la red local use la IP del PC, ej. http://192.168.1.20:5173
PUBLIC_URL="http://localhost:5173"
# Rol con el que corre la aplicación (sin privilegios especiales, RLS lo limita). seed.py lo crea.
DB_APP_USER="restaurant_app"
DB_APP_PASS="your_app_password_here"
