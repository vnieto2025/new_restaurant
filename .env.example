# Variables de docker-compose. Copie este archivo como .env y cambie los valores.

# Puerto del servidor donde queda la aplicación (http://servidor:APP_PORT)
APP_PORT=80

# Dirección pública con la que se arman los QR de las mesas (sin / al final)
PUBLIC_URL=http://localhost

# Base de datos (el contenedor de Postgres se crea con estos datos la primera vez)
DB_USER=restaurant
DB_PASS=cambie-esta-clave
DB_NAME=restaurant

# Rol con el que corre la aplicación (sin privilegios: Row Level Security la limita)
DB_APP_USER=restaurant_app
DB_APP_PASS=cambie-esta-otra-clave

# Clave para firmar las sesiones (JWT). Use una cadena larga y aleatoria, por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MY_SECRET_KEY=cambie-esta-clave-secreta

# Respaldos: hora del día (00 a 23), días que se conservan y carpeta del servidor
RESPALDO_HORA=04
RESPALDO_DIAS=30
RESPALDOS_DIR=./respaldos
